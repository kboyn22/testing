import requests
from requests.auth import HTTPBasicAuth
import os

username = os.getenv('API_USERNAME')
password = os.getenv('API_PASSWORD')

#troubleshooting only - confirming if username and pw are being called in. 
print(f"Username: {username}")
print(f"Password: {'*' * len(password) if password else 'Not set'}")

# Define the initial URL
url = 'https://analytics-api.app.lithium.com/api/public/reports/report/conversation?companyKey=khoros&startTime=1709445600000&endTime=1710007199000'

# Make the initial request
response = requests.get(url, auth=HTTPBasicAuth(username, password))

print(f"Initial response status code: {response.status_code}")

if response.status_code == 200:
    response_data = response.json()
    print("Initial response data:", response_data)

    # Check if statusUrl is present in the response
    if 'statusUrl' in response_data:
        status_url = response_data['statusUrl']
        print(f"Status URL: {status_url}")

        # Make a request to the status URL
        status_response = requests.get(status_url, auth=HTTPBasicAuth(username, password))
        
        print(f"Status response status code: {status_response.status_code}")
        
        if status_response.status_code == 200:
            status_data = status_response.json()
            print("Status response data:", status_data)
            
            # Check if downloadUrl is present in the status response
            if 'downloadUrl' in status_data:
                download_url = status_data['downloadUrl']
                print(f"Download URL: {download_url}")
            else:
                print("Error: Download URL not found in the status response.")
        else:
            print(f"Error: Status request failed with status code {status_response.status_code}")
    else:
        print("Error: Status URL not found in the initial response.")
else:
    print(f"Error: Initial request failed with status code {response.status_code}")
